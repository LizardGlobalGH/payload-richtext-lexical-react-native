{
  "include": [
    "src",
    "package.json"
  ],
  "exclude": [
    ".swcrc",
    "eslint.config.js",
    "README.md",
    "tsconfig.json"
  ],
  "clean": {
    "keep": [
      "src/index.ts",
      "src/exports/client/index.ts",
      "src/exports/cssEntry.ts",
      "src/exports/react-native/index.ts",
      "src/exports/shared.ts"
    ],
    "match": [
      "\\.(ts|tsx|mts|cts)$",
      "\\.(js|jsx|mjs|cjs)$"
    ]
  },
  "partial": {
    "package.json": {
      "keys": {
        "exclude": [
          "name",
          "version",
          "description",
          "homepage",
          "repository",
          "author",
          "maintainers",
          "scripts.upstream:deps",
          "exports[\"./react-native\"]",
          "peerDependencies.react-native",
          "peerDependenciesMeta.react-native",
          "peerDependencies.payload",
          "devDependencies.payload",
          "devDependencies.@payloadcms/eslint-config",
          "dependencies.@payloadcms/translations",
          "dependencies.@payloadcms/ui",
          "devDependencies.commander"
        ]
      }
    }
  }
}
